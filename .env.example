# Copy to .env for local runs. Never commit .env.

# The only required setting. Create one under Products in your IndraTrace workspace.
INDRATRACE_API_KEY=

# IndraTrace developers / self-hosted only: the gateway's base URL, no path.
# INDRATRACE_ENDPOINT=http://localhost:8088

# INDRATRACE_DEBUG=1
# INDRATRACE_CAPTURE_CONTENT=0
# INDRATRACE_PREFLIGHT=warn
